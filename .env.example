# --- LiveKit Project Credentials ---
# Get these by creating a project at https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# --- Token Server & Room Setup ---
TOKEN_SERVER_URL=http://127.0.0.1:8000/get-token
LIVEKIT_ROOM=voice-room
AGENT_IDENTITY=agent1

# Groq API key — for STT and LLM (free tier)
# Get it at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cartesia API key for Text-to-Speech (TTS)
# Get it at https://play.cartesia.ai/console
CARTESIA_API_KEY=your_cartesia_api_key_here